DATABASE_URL=postgresql://codeduel:codeduel_local@localhost:5432/codeduel
# Optional sandbox configuration for the future match server (map into JudgeConfig).
# Use an isolated, maintained Judge0 deployment; do not send code to a public default.
JUDGE0_URL=http://localhost:2358
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_AUTH_TOKEN=
JUDGE0_CPU_LIMIT_SECONDS=2
JUDGE0_MEMORY_LIMIT_KB=128000

# Required in production: exact public origin for auth POST origin checks.
APP_ORIGIN=http://localhost:3000

# Single authoritative WebSocket worker. Proxy /matchmaking to this listener.
MATCHMAKING_HOST=127.0.0.1
MATCHMAKING_PORT=3001
